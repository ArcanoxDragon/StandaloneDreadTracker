<ResourceDictionary xmlns="https://github.com/avaloniaui"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Design.PreviewWith>
		<Grid Margin="4"
			  RowDefinitions="*,*,*,*"
			  ColumnDefinitions="40,Auto"
			  RowSpacing="4"
			  ColumnSpacing="4">
			<Grid.Styles>
				<Style Selector=":is(Control)">
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
			</Grid.Styles>

			<PathIcon Grid.Row="0" Grid.Column="0"
					  Data="{DynamicResource FolderOpenIcon}" />

			<TextBlock Grid.Row="0" Grid.Column="1"
					   Text="folder-open" />

			<PathIcon Grid.Row="1" Grid.Column="0"
					  Data="{DynamicResource EllipsisIcon}" />

			<TextBlock Grid.Row="1" Grid.Column="1"
					   Text="ellipsis" />

			<PathIcon Grid.Row="2" Grid.Column="0"
					  Data="{DynamicResource PenIcon}" />

			<TextBlock Grid.Row="2" Grid.Column="1"
					   Text="pen" />

			<PathIcon Grid.Row="3" Grid.Column="0"
					  Data="{DynamicResource TrashIcon}" />

			<TextBlock Grid.Row="3" Grid.Column="1"
					   Text="trash" />
		</Grid>
	</Design.PreviewWith>

