<ResourceDictionary xmlns="https://github.com/avaloniaui"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Design.PreviewWith>
		<StackPanel Margin="4">
			<StackPanel.Styles>
				<Style Selector="StackPanel">
					<Setter Property="Spacing" Value="10" />

					<Style Selector="^ StackPanel">
						<Setter Property="Orientation" Value="Horizontal" />

						<Style Selector="^ :is(Control)">
							<Setter Property="VerticalAlignment" Value="Center" />
						</Style>

						<Style Selector="^ PathIcon">
							<Setter Property="Width" Value="24" />
						</Style>
					</Style>
				</Style>
			</StackPanel.Styles>

			<StackPanel>
				<PathIcon Data="{DynamicResource EllipsisIcon}" />
				<TextBlock Text="ellipsis" />
			</StackPanel>

			<StackPanel>
				<PathIcon Data="{DynamicResource ExternalLinkIcon}" />
				<TextBlock Text="external-link" />
			</StackPanel>

			<StackPanel>
				<PathIcon Data="{DynamicResource FolderOpenIcon}" />
				<TextBlock Text="folder-open" />
			</StackPanel>

			<StackPanel>
				<PathIcon Data="{DynamicResource NewIcon}" />
				<TextBlock Text="new" />
			</StackPanel>

			<StackPanel>
				<PathIcon Data="{DynamicResource PenIcon}" />
				<TextBlock Text="pen" />
			</StackPanel>

			<StackPanel>
				<PathIcon Data="{DynamicResource PlusIcon}" />
				<TextBlock Text="plus" />
			</StackPanel>

			<StackPanel>
				<PathIcon Data="{DynamicResource SettingsIcon}" />
				<TextBlock Text="settings" />
			</StackPanel>

			<StackPanel>
				<PathIcon Data="{DynamicResource TrashIcon}" />
				<TextBlock Text="trash" />
			</StackPanel>
		</StackPanel>
	</Design.PreviewWith>

