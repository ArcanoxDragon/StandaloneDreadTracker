<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:utilities="clr-namespace:StandaloneDreadTracker.UI.Avalonia.Utilities">
	<Style Selector="Window.MicaWindow">
		<Setter Property="TransparencyLevelHint" Value="Mica" />

		<Style Selector="^[(utilities|WindowHelpers.IsUsingMica)=True]">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />

			<Style Selector="^ Border.TitleBar">
				<Setter Property="MinHeight" Value="40" />
				<Setter Property="Padding" Value="8" />
				<Setter Property="IsVisible" Value="{Binding $parent[Window].IsExtendedIntoWindowDecorations}" />
				<Setter Property="IsHitTestVisible" Value="False" />

				<Style Selector="^ TextBlock">
					<Setter Property="Text" Value="{Binding $parent[Window].Title}" />
					<Setter Property="TextAlignment" Value="Center" />
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
			</Style>

			<Style Selector="^[WindowState=Maximized]">
				<Setter Property="Padding" Value="8" />

				<Style Selector="^ Border.TitleBar">
					<Setter Property="Padding" Value="0" />
				</Style>

				<Style Selector="^ Menu > MenuItem">
					<Setter Property="Padding" Value="10,0,10,0" />
				</Style>
			</Style>
		</Style>
	</Style>
</Styles>