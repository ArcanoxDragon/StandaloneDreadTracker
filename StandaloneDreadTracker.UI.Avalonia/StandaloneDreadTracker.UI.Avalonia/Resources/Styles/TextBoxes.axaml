<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Design.PreviewWith>
		<StackPanel Width="300"
					Margin="4"
					Spacing="4">
			<StackPanel.Styles>
				<Style Selector="TextBox">
					<Setter Property="HorizontalAlignment" Value="Stretch" />
				</Style>
			</StackPanel.Styles>

			<TextBox Watermark="Normal Text Box" />

			<TextBox Watermark="Disabled Text Box"
					 IsEnabled="False" />

			<TextBox Watermark="Invalid Text Box"
					 Classes="Invalid" />
		</StackPanel>
	</Design.PreviewWith>

	<Style Selector="TextBox.Invalid">
		<Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />

		<Style Selector="^:pointerover /template/ Border#PART_BorderElement">
			<Setter Property="BorderBrush" Value="{DynamicResource ErrorLowBrush}" />
		</Style>
	</Style>
</Styles>