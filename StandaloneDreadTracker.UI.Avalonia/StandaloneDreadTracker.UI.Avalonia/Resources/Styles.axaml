		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Styles.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="/Resources/Theme.axaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Styles.Resources>

	<StyleInclude Source="/Resources/Styles/Buttons.axaml" />
	<StyleInclude Source="/Resources/Styles/Dialogs.axaml" />
	<StyleInclude Source="/Resources/Styles/Windows.axaml" />
</Styles>