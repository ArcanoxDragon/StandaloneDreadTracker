<ResourceDictionary xmlns="https://github.com/avaloniaui"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<SolidColorBrush x:Key="ErrorBrush"
					 Color="#dd4422" />
	<SolidColorBrush x:Key="ErrorLowBrush"
					 Color="#f27154" />

	<ResourceDictionary.ThemeDictionaries>
		<ResourceDictionary x:Key="Default">
			<Color x:Key="SystemRegionColor">#fff8f8f8</Color>
			<Color x:Key="ImmersiveWindowBorderColor">#ffe0e0e0</Color>
			<Color x:Key="PrimaryTextColor">#ff181818</Color>

			<SolidColorBrush x:Key="SystemRegionBrush"
							 Color="{StaticResource SystemRegionColor}" />
			<SolidColorBrush x:Key="ImmersiveWindowBorderBrush"
							 Color="{StaticResource ImmersiveWindowBorderColor}" />
			<SolidColorBrush x:Key="PrimaryTextBrush"
							 Color="{StaticResource PrimaryTextColor}" />

			<SolidColorBrush x:Key="ButtonBorderBrush"
							 Color="{StaticResource SystemBaseHighColor}"
							 Opacity="0.1" />
			<SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
							 Color="{StaticResource SystemBaseHighColor}"
							 Opacity="0.1" />
			<SolidColorBrush x:Key="ButtonBorderBrushPressed"
							 Color="{StaticResource SystemBaseHighColor}"
							 Opacity="0.1" />
		</ResourceDictionary>
		<ResourceDictionary x:Key="Dark">
			<Color x:Key="SystemRegionColor">#ff181818</Color>
			<Color x:Key="ImmersiveWindowBorderColor">#ff303030</Color>
			<Color x:Key="PrimaryTextColor">#ffe8e8e8</Color>

			<SolidColorBrush x:Key="SystemRegionBrush"
							 Color="{StaticResource SystemRegionColor}" />
			<SolidColorBrush x:Key="ImmersiveWindowBorderBrush"
							 Color="{StaticResource ImmersiveWindowBorderColor}" />
			<SolidColorBrush x:Key="PrimaryTextBrush"
							 Color="{StaticResource PrimaryTextColor}" />

			<SolidColorBrush x:Key="ButtonBorderBrush"
							 Color="{StaticResource SystemBaseHighColor}"
							 Opacity="0.1" />
			<SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
							 Color="{StaticResource SystemBaseHighColor}"
							 Opacity="0.1" />
			<SolidColorBrush x:Key="ButtonBorderBrushPressed"
							 Color="{StaticResource SystemBaseHighColor}"
							 Opacity="0.1" />
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>