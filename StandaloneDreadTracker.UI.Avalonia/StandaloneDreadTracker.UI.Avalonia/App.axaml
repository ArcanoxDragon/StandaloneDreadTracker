<Application xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:dataTemplates="clr-namespace:StandaloneDreadTracker.UI.Avalonia.DataTemplates"
			 xmlns:converters="clr-namespace:StandaloneDreadTracker.UI.Avalonia.Converters"
			 x:Class="StandaloneDreadTracker.UI.Avalonia.App"
			 RequestedThemeVariant="Default">
	<Application.DataTemplates>
		<dataTemplates:ViewLocator />
	</Application.DataTemplates>

	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<MergeResourceInclude Source="/Resources/Icons.axaml" />
			</ResourceDictionary.MergedDictionaries>

			<SolidColorBrush x:Key="ErrorBrush"
							 Color="#dd4422" />

			<converters:DimensionToGridLengthConverter x:Key="DimensionToGridLengthConverter" />
		</ResourceDictionary>
	</Application.Resources>

	<Application.Styles>
		<FluentTheme />
		<StyleInclude Source="/Resources/Styles.axaml" />
	</Application.Styles>
</Application>