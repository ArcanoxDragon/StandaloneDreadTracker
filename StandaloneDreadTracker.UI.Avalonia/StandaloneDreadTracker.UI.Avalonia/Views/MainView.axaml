<r:ReactiveUserControl x:TypeArguments="viewModels:MainViewModel"
					   xmlns="https://github.com/avaloniaui"
					   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
					   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
					   xmlns:viewModels="clr-namespace:StandaloneDreadTracker.App.ViewModels;assembly=StandaloneDreadTracker.App"
					   xmlns:r="http://reactiveui.net"
					   mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
					   x:Class="StandaloneDreadTracker.UI.Avalonia.Views.MainView"
					   x:DataType="viewModels:MainViewModel">
	<Design.DataContext>
		<viewModels:MainViewModel />
	</Design.DataContext>

	<ItemsControl ItemsSource="{Binding TrackerTargets}" />
</r:ReactiveUserControl>