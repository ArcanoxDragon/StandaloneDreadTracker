<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:tracker="clr-namespace:StandaloneDreadTracker.UI.Avalonia.Views.Tracker"
			 xmlns:system="clr-namespace:System;assembly=System.Runtime"
			 mc:Ignorable="d"
			 x:Class="StandaloneDreadTracker.UI.Avalonia.Views.Tracker.ItemTile"
			 Name="Self">
	<Design.DesignStyle>
		<Style Selector="tracker|ItemTile">
			<Setter Property="IsCollected" Value="True" />
			<Setter Property="GroupBackground" Value="Red" />
			<Setter Property="ShowGroupBackground" Value="True" />
			<Setter Property="IsFirstInGroup" Value="True" />
			<Setter Property="IsLastInGroup" Value="True" />
			<Setter Property="Icon" Value="/Assets/Placeholders/item-icons/beam-wide.png" />
			<Setter Property="IconSize" Value="64" />
			<Setter Property="AuxText" Value="1.5s" />
		</Style>
	</Design.DesignStyle>

	<UserControl.Resources>
		<system:String x:Key="SvgIconFadeCss">
			g { opacity: 0.3 !important; }
		</system:String>
	</UserControl.Resources>

	<UserControl.Styles>
		<Style Selector="Panel.RootPanel">
			<Setter Property="Margin" Value="0,0,0,4" />
		</Style>

		<Style Selector="Grid.LayoutGrid">
			<Setter Property="Margin" Value="4,4,8,4" />
		</Style>

		<Style Selector="Border.BadgeBorder">
			<Setter Property="BorderBrush" Value="{DynamicResource SystemRegionBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Background" Value="{DynamicResource TextControlForeground}" />
			<Setter Property="CornerRadius" Value="12" />
			<Setter Property="MinWidth" Value="24" />
			<Setter Property="Height" Value="24" />
		</Style>

		<Style Selector="TextBlock.BadgeText">
			<Setter Property="FontSize" Value="16" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Foreground" Value="{DynamicResource SystemRegionBrush}" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<Style Selector="tracker|ItemTile[IsCollected=False]">
			<!-- Need to apply CSS directly to this control if IconPath is an SVG image -->
			<Setter Property="Svg.Css" Value="{StaticResource SvgIconFadeCss}" />

			<Style Selector="^ Image.Icon">
				<Setter Property="Opacity" Value="0.3" />
			</Style>
		</Style>

		<Style Selector="tracker|ItemTile[IsFirstInGroup=True]">
			<Style Selector="^ Border.GroupBackgroundBorder">
				<Setter Property="CornerRadius" Value="16,0,0,16" />
			</Style>
		</Style>

		<Style Selector="tracker|ItemTile[IsLastInGroup=True]">
			<Style Selector="^ Panel.RootPanel">
				<Setter Property="Margin" Value="0,0,4,4" />
			</Style>

			<Style Selector="^ Border.GroupBackgroundBorder">
				<Setter Property="CornerRadius" Value="0,16,16,0" />
			</Style>

			<Style Selector="^ Grid.LayoutGrid">
				<Setter Property="Margin" Value="4" />
			</Style>
		</Style>

		<Style Selector="tracker|ItemTile[IsFirstInGroup=True][IsLastInGroup=True]">
			<Style Selector="^ Border.GroupBackgroundBorder">
				<Setter Property="CornerRadius" Value="16,16,16,16" />
			</Style>
		</Style>

		<Style Selector="tracker|ItemTile[ShowGroupBackground=False]">
			<Style Selector="^ Border.GroupBackgroundBorder">
				<Setter Property="IsVisible" Value="False" />
			</Style>
		</Style>
	</UserControl.Styles>

	<Panel DataContext="{Binding #Self}" Classes="RootPanel">
		<Border Classes="GroupBackgroundBorder"
				Background="{Binding GroupBackground}"
				Opacity="0.5" />

		<Grid Classes="LayoutGrid"
			  RowDefinitions="Auto,*,Auto"
			  ColumnDefinitions="Auto,*,Auto">
			<!-- Image -->
			<Border Grid.Row="0" Grid.RowSpan="3"
					Grid.Column="0" Grid.ColumnSpan="3"
					Background="Black"
					Width="{Binding IconSize}"
					Height="{Binding IconSize}"
					CornerRadius="{Binding IconSize, Converter={x:Static tracker:ItemTile.IconCornerRadiusConverter}}">
				<Image Source="{Binding Icon}"
					   Classes="Icon" />
			</Border>

			<!-- Location Hint -->
			<Border Grid.Row="0" Grid.Column="0"
					VerticalAlignment="Top"
					Classes="BadgeBorder">
				<Border.IsVisible>
					<!-- TODO: Add setting to determine whether or not this is hidden when collected -->
					<MultiBinding Converter="{x:Static BoolConverters.And}">
						<Binding Path="ShowLocationHint" />
						<Binding Path="IsCollected" Converter="{x:Static BoolConverters.Not}" />
					</MultiBinding>
				</Border.IsVisible>

				<TextBlock Classes="BadgeText"
						   Text="{Binding LocationHint}" />
			</Border>

			<!-- Aux Text -->
			<Border Grid.Row="2"
					Grid.Column="0"
					Grid.ColumnSpan="3"
					IsVisible="{Binding AuxText, Converter={x:Static ObjectConverters.IsNotNull}}"
					HorizontalAlignment="Right"
					VerticalAlignment="Bottom"
					Classes="BadgeBorder">
				<TextBlock Classes="BadgeText"
						   FontSize="12"
						   Margin="4"
						   Text="{Binding AuxText}" />
			</Border>
		</Grid>
	</Panel>
</UserControl>