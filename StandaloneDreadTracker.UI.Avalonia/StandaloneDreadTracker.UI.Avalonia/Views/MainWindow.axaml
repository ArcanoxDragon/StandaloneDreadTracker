<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:views="using:StandaloneDreadTracker.UI.Avalonia.Views"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		x:Class="StandaloneDreadTracker.UI.Avalonia.Views.MainWindow"
		Name="Self"
		Icon="/Assets/avalonia-logo.ico"
		Title="Dread Randomizer Tracker"
		TransparencyLevelHint="Mica"
		Background="Transparent"
		ExtendClientAreaToDecorationsHint="True">
	<Grid RowDefinitions="40,*">
		<Border Padding="4"
				IsVisible="{Binding #Self.IsExtendedIntoWindowDecorations}"
				IsHitTestVisible="False">
			<TextBlock Text="{Binding #Self.Title}"
					   TextAlignment="Center"
					   VerticalAlignment="Center" />
		</Border>

		<views:MainView Grid.Row="1" />
	</Grid>
</Window>