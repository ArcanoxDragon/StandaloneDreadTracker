<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:views="using:StandaloneDreadTracker.UI.Avalonia.Views"
		xmlns:viewModels="clr-namespace:StandaloneDreadTracker.App.ViewModels;assembly=StandaloneDreadTracker.App"
		xmlns:designTime="clr-namespace:StandaloneDreadTracker.UI.Avalonia.DesignTime"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		x:Class="StandaloneDreadTracker.UI.Avalonia.Views.MainWindow"
		x:DataType="viewModels:MainViewModel"
		Name="Self"
		Icon="/Assets/avalonia-logo.ico"
		Title="Dread Randomizer Tracker"
		Classes="MicaWindow"
		Design.DataContext="{x:Static designTime:DesignTimeModels.MainViewModel}">
	<Grid RowDefinitions="Auto,*">
		<Border Classes="TitleBar">
			<TextBlock />
		</Border>

		<views:MainView Grid.Row="1" />
	</Grid>
</Window>