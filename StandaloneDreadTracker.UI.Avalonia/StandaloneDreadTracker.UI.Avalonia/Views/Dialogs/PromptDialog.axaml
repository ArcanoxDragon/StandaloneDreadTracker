<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d"
		x:Class="StandaloneDreadTracker.UI.Avalonia.Views.Dialogs.PromptDialog"
		Name="Dialog"
		Icon="/Assets/avalonia-logo.ico"
		WindowStartupLocation="CenterOwner"
		Classes="Dialog NoControlButtons MicaWindow ImmersiveWindow"
		SizeToContent="WidthAndHeight"
		CanResize="False"
		ExtendClientAreaTitleBarHeightHint="-1">
	<Grid RowDefinitions="*,Auto,Auto" Margin="20,10" MaxWidth="600">
		<TextBlock Grid.Row="0" Text="{Binding #Dialog.Message}" TextWrapping="Wrap" />

		<TextBox x:Name="InputTextBox"
				 Grid.Row="1"
				 Margin="0,10,0,0"
				 Text="{Binding #Dialog.InputText}"
				 Watermark="{Binding #Dialog.InputWatermark}" />

		<StackPanel Grid.Row="2" Orientation="Horizontal" Classes="ButtonContainer">
			<Button Content="{Binding #Dialog.PositiveText}"
					IsDefault="True"
					IsEnabled="{Binding #Dialog.InputText.Length}"
					Command="{Binding #Dialog.OnPositiveButtonClicked}"
					Classes.accent="{Binding #Dialog.PositiveButtonAccent}" />

			<Button Content="{Binding #Dialog.NegativeText}"
					IsCancel="True"
					Command="{Binding #Dialog.OnNegativeButtonClicked}" />
		</StackPanel>
	</Grid>
</Window>